{
  "name": "@asymmetric-effort/gh-release",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub Action to create or update GitHub Releases with asset uploads",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.ts -o dist",
