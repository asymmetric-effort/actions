{
  "name": "@asymmetric-effort/setup-bun",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub Action to install and configure the Bun runtime",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.ts -o dist && ncc build src/post.ts -o dist/post --out dist/post-tmp && mv dist/post-tmp/index.js dist/post.js && rm -rf dist/post-tmp",
    "test": "jest --coverage --coverageThreshold='{\"global\":{\"branches\":98,\"functions\":98,\"lines\":98,\"statements\":98}}'",
    "lint": "eslint src/ __tests__/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/exec": "^1.1.1",
    "@actions/io": "^1.1.3",
    "@actions/tool-cache": "^2.0.1",
    "@actions/cache": "^3.2.4",
    "@actions/http-client": "^2.2.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vercel/ncc": "^0.38.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^6.0.3"
  }
}
